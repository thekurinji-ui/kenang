// Kenang Kurinji Blueprint v2.0 — Volume 6: Database & Prisma
// PostgreSQL + Prisma ORM. Semua data dipusatkan pada konsep Event.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  GUEST
  VIEWER
}

enum EventStatus {
  DRAFT
  LIVE
  ENDED
  ARCHIVED
}

enum RevealMode {
  INSTANT
  AFTER_EVENT_ENDS
}

enum Plan {
  KINCAI
  KURINJI
  GUNUNG_TUJUH
  GUNUNG_KERINCI
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

enum FilmStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Kenang Kurinji v2.1 — Film Collection dinamis (Catatan Developer blueprint:
// "Film Collection harus bersifat dinamis (database/folder), bukan
// hardcoded"). `minPlan` menentukan gating: sebuah film cuma tersedia untuk
// event yang plan snapshot-nya >= minPlan (lihat PLAN_RANK/isPlanAtLeast di
// src/lib/plans.ts). Film dengan minPlan KINCAI = fitur dasar "Disposable
// Camera", tersedia semua plan. Film dengan minPlan GUNUNG_TUJUH = "Film
// Collection" eksklusif.
model Film {
  id           String     @id @default(uuid())
  slug         String     @unique // dipakai sebagai Photo.filmType & kunci upsert seed
  name         String
  category     String? // mis. "Disposable Camera", "Film Collection"
  swatch       String? // warna hex representatif untuk chip di film selector
  thumbnailUrl String?    @map("thumbnail_url")
  lutUrl       String     @map("lut_url") // path PNG strip LUT (public/luts/**)
  lutSize      Int        @default(32) @map("lut_size")
  grain        Float      @default(0)
  vignette     Boolean    @default(false)
  minPlan      Plan       @default(KINCAI) @map("min_plan")
  status       FilmStatus @default(ACTIVE)
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([minPlan])
  @@map("films")
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  emailVerified        DateTime?             @map("email_verified")
  passwordHash         String?               @map("password_hash")
  avatarUrl            String?               @map("avatar_url")
  image                String?
  role                 Role                  @default(OWNER)
  events               Event[]
  subscription         Subscription?
  paymentOrders        PaymentOrder[]
  passwordResetTokens  PasswordResetToken[]
  accounts             Account[]
  blogPosts            BlogPost[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

// Wajib ada — dipakai NextAuth (PrismaAdapter) untuk menyimpan koneksi
// login OAuth (mis. Google). Nama field di sini (userId, providerAccountId,
// access_token, dst) mengikuti kontrak resmi Auth.js, jangan diubah —
// hanya nama tabel/kolom fisik di DB (lewat @@map/@map) yang disesuaikan
// gaya snake_case seperti model lain di file ini.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Event {
  id           String      @id @default(uuid())
  owner        User        @relation(fields: [ownerId], references: [id])
  ownerId      String      @map("owner_id")
  title        String
  slug         String      @unique
  description  String?
  coverImage   String?     @map("cover_image")
  eventDate    DateTime?   @map("event_date")
  location     String?
  status       EventStatus @default(DRAFT)
  revealMode   RevealMode  @default(INSTANT) @map("reveal_mode")
  shotLimit    Int?        @map("shot_limit") // null = unlimited
  // Snapshot plan pemilik SAAT event dibuat (Volume 2/blueprint v2.1: harga
  // per-Event, jadi limit event ini tidak boleh ikut berubah kalau host
  // upgrade/downgrade subscription belakangan).
  plan         Plan        @default(KINCAI)
  // Masa aktif event: createdAt + activeDays plan (30 hari Kincai, 1 tahun
  // Kurinji/Gunung Tujuh, null/tanpa batas untuk Gunung Kerinci). Setelah
  // lewat, event full-lock — guest flow (join, upload, buka halaman) ditolak.
  activeUntil  DateTime?   @map("active_until")
  deletedAt    DateTime?   @map("deleted_at") // soft delete

  // AI Features v3.0 — Feature 2 (AI Story). Narasi disimpan supaya tidak
  // perlu panggil OpenAI ulang tiap kali halaman dibuka (lihat AI Blueprint).
  aiStory            String?   @map("ai_story")
  aiStoryGeneratedAt DateTime? @map("ai_story_generated_at")

  guests       Guest[]
  photos       Photo[]
  albums       Album[]
  qrCode       QRCode?
  analytics    Analytics?

  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([slug])
  @@map("events")
}

model Guest {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String   @map("event_id")
  nickname  String?
  deviceId  String   @map("device_id")
  isBanned  Boolean  @default(false) @map("is_banned")
  photos    Photo[]
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@index([eventId])
  @@map("guests")
}

model Photo {
  id            String   @id @default(uuid())
  event         Event    @relation(fields: [eventId], references: [id])
  eventId       String   @map("event_id")
  guest         Guest?   @relation(fields: [guestId], references: [id])
  guestId       String?  @map("guest_id")
  album         Album?   @relation(fields: [albumId], references: [id])
  albumId       String?  @map("album_id")
  storageKey    String   @map("storage_key")
  thumbnailKey  String?  @map("thumbnail_key")
  width         Int?
  height        Int?
  filmType      String   @map("film_type")
  frameType     String?  @map("frame_type")
  isFavorite    Boolean  @default(false) @map("is_favorite")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  // AI Features v3.0 (lihat AI Blueprint). Diisi oleh pipeline AI yang
  // jalan asynchronous setelah upload — bisa null selama belum sempat/gagal
  // dianalisis, foto tetap tampil normal di gallery tanpa fitur ini.
  aiScore       Int?      @map("ai_score") // 0-100, Feature 1: AI Best Shot
  aiReason      String?   @map("ai_reason") // alasan singkat dari AI
  aiIsBestShot  Boolean   @default(false) @map("ai_is_best_shot")
  aiCategory    String?   @map("ai_category") // Feature 3: AI Smart Gallery
  aiAnalyzedAt  DateTime? @map("ai_analyzed_at")

  @@index([eventId])
  @@index([eventId, aiScore])
  @@map("photos")
}

model Album {
  id          String  @id @default(uuid())
  event       Event   @relation(fields: [eventId], references: [id])
  eventId     String  @map("event_id")
  title       String
  description String?
  photos      Photo[]

  // AI Features v3.0 — Feature 3 (AI Smart Gallery) auto-create satu Album
  // per kategori (Ceremony, Reception, dst) memakai upsert, jadi title harus
  // unik per event supaya tidak dobel.
  @@unique([eventId, title])
  @@map("albums")
}

model QRCode {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String   @unique @map("event_id")
  code      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([code])
  @@map("qr_codes")
}

model Subscription {
  id        String             @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String             @unique @map("user_id")
  plan      Plan               @default(KINCAI)
  status    SubscriptionStatus @default(ACTIVE)
  expiresAt DateTime?          @map("expires_at")

  @@map("subscriptions")
}

model PaymentOrder {
  id            String             @id @default(uuid())
  user          User               @relation(fields: [userId], references: [id])
  userId        String             @map("user_id")
  orderId       String             @unique @map("order_id")
  plan          Plan
  amount        Int
  status        PaymentOrderStatus @default(PENDING)
  paymentType   String?            @map("payment_type")
  transactionId String?            @map("transaction_id")
  snapToken     String?            @map("snap_token")
  paidAt        DateTime?          @map("paid_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payment_orders")
}

model Analytics {
  id           String   @id @default(uuid())
  event        Event    @relation(fields: [eventId], references: [id])
  eventId      String   @unique @map("event_id")
  totalPhotos  Int      @default(0) @map("total_photos")
  totalGuests  Int      @default(0) @map("total_guests")
  storageUsed  Int      @default(0) @map("storage_used") // bytes
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("analytics")
}

// --- Blog (Volume 8: Kenang Blog) ---
// Konten ditulis admin lewat dashboard admin (belum ada — menyusul di
// langkah berikutnya). DRAFT tidak tampil di /blog publik sampai di-publish.
enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String         @db.Text // Markdown
  coverImage  String?        @map("cover_image")
  status      BlogPostStatus @default(DRAFT)
  author      User           @relation(fields: [authorId], references: [id])
  authorId    String         @map("author_id")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("blog_posts")
}
