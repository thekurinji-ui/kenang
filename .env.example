# Database
# DATABASE_URL: pooled connection (dipakai app saat runtime)
# DIRECT_URL: non-pooled connection (dipakai Prisma saat migrate)
DATABASE_URL="postgresql://user:password@localhost:5432/kenang_kurinji"
DIRECT_URL="postgresql://user:password@localhost:5432/kenang_kurinji"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Resend (kirim email reset password) — daftar gratis di resend.com
# Tanpa domain sendiri, isi EMAIL_FROM dengan "Kenang Kurinji <onboarding@resend.dev>"
# (mode itu hanya bisa kirim ke email akun Resend kamu sendiri, cocok buat testing)
RESEND_API_KEY=""
EMAIL_FROM="Kenang Kurinji <onboarding@resend.dev>"

# Google OAuth (opsional, sesuai PRD Volume 2)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudflare R2 (object storage untuk foto)
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL: domain publik bucket (custom domain, atau r2.dev public URL)
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="kenang-kurinji-photos"
R2_PUBLIC_URL=""
# Sama seperti R2_PUBLIC_URL, tapi diakses dari browser (client component)
# jadi wajib pakai prefix NEXT_PUBLIC_. Isi dengan nilai yang sama.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Midtrans (payment gateway upgrade plan)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
